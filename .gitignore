# Python
backend/venv/
__pycache__/
*.py[cod]
*.egg-info/

# Env / secrets (backend/.env holds real credentials; frontend/.env has no
# secrets and is committed so a fresh clone has a working default)
backend/.env
.env.local
!.env.example

# Editor / OS
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json

# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vercel/

# Backend build artifact (frontend build copied in here by the Render
# build step so FastAPI can serve it as static files)
backend/static_dist/
