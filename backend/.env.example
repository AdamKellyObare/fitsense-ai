OPENAI_API_KEY=
USE_REAL_AI=false

# AI-generated meal photos (gpt-image-1). USE_AI_PHOTOS turns the pipeline
# on/off (background generation, caching, status polling); with it on but
# USE_REAL_AI_PHOTOS off, a free mock generator runs instead of calling
# OpenAI, so the whole pipeline is testable at no cost. USE_REAL_AI_PHOTOS
# is deliberately separate from USE_REAL_AI (calorie-estimation text) —
# photo generation costs meaningfully more per call and gets its own
# explicit opt-in. Real generation requires an S3-compatible bucket
# (Cloudflare R2 recommended: no egress fees) since OpenAI's own response is
# transient and the backend's local disk isn't guaranteed persistent once
# deployed.
USE_AI_PHOTOS=false
USE_REAL_AI_PHOTOS=false
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL_BASE=

ENV=development

# postgresql+asyncpg://user:password@ep-xxxx.us-east-2.aws.neon.tech/fitsense?ssl=require
DATABASE_URL=

# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated if serving more than one client origin, e.g. the web app
# plus the Capacitor native shell: http://localhost:5173,capacitor://localhost,https://localhost
# (capacitor://localhost is iOS's fixed WKWebView origin — it cannot be
# changed to http/https, WKWebView rejects that as a custom scheme override.
# https://localhost is Android's, via androidScheme in capacitor.config.json.
# Cookie secure/samesite is decided per-request in core/security.py, not by
# a single global flag, so the same backend can serve same-site web traffic
# and cross-site native-shell traffic correctly at the same time.)
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
